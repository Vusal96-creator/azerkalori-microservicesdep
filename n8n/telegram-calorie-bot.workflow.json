{
  "name": "AzerKalori Telegram Bot",
  "nodes": [
    {
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [-660, 240],
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "webhookId": "azerkalori-tg-0001",
      "credentials": { "telegramApi": { "id": "TG_CRED", "name": "Telegram bot" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "cond-hesabat",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "/hesabat",
              "operator": { "type": "string", "operation": "startsWith" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-440, 240],
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "If /hesabat"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(SUM(calories),0) AS toplam FROM telegram_food_logs WHERE chat_id = {{ $('Telegram Trigger').item.json.message.chat.id }} AND created_at::date = CURRENT_DATE",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-220, 140],
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Bugünkü kalori (SQL)",
      "credentials": { "postgres": { "id": "PG_CRED", "name": "Azerkalori Postgres" } }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=📊 Bugünkü ümumi kalorin: {{ $json.toplam }} kcal",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [0, 140],
      "id": "c1000000-0000-4000-8000-000000000004",
      "name": "Hesabatı göndər",
      "webhookId": "azerkalori-tg-send-1",
      "credentials": { "telegramApi": { "id": "TG_CRED", "name": "Telegram bot" } }
    },
    {
      "parameters": {
        "jsCode": "// Format: \"<qida adı> <kalori>\"  ->  məs: \"alma 52\"\nconst text = ($json.message.text || '').trim();\nconst parts = text.split(/\\s+/);\nconst calRaw = parts[parts.length - 1].replace(',', '.');\nconst calories = parseFloat(calRaw);\nconst food = parts.slice(0, -1).join(' ') || 'naməlum';\nreturn [{ json: {\n  chat_id: $json.message.chat.id,\n  food: food,\n  calories: isNaN(calories) ? 0 : calories\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-220, 340],
      "id": "c1000000-0000-4000-8000-000000000005",
      "name": "Qidanı ayrıştır"
    },
    {
      "parameters": {
        "schema": { "__rl": true, "mode": "list", "value": "public" },
        "table": { "__rl": true, "value": "telegram_food_logs", "mode": "list", "cachedResultName": "telegram_food_logs" },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": ["id"],
          "value": {}
        },
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [0, 340],
      "id": "c1000000-0000-4000-8000-000000000006",
      "name": "Qeydi saxla",
      "credentials": { "postgres": { "id": "PG_CRED", "name": "Azerkalori Postgres" } }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=✅ Qeyd olundu: {{ $json.food }} — {{ $json.calories }} kcal",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [220, 340],
      "id": "c1000000-0000-4000-8000-000000000007",
      "name": "Təsdiq göndər",
      "webhookId": "azerkalori-tg-send-2",
      "credentials": { "telegramApi": { "id": "TG_CRED", "name": "Telegram bot" } }
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "If /hesabat", "type": "main", "index": 0 }]] },
    "If /hesabat": {
      "main": [
        [{ "node": "Bugünkü kalori (SQL)", "type": "main", "index": 0 }],
        [{ "node": "Qidanı ayrıştır", "type": "main", "index": 0 }]
      ]
    },
    "Bugünkü kalori (SQL)": { "main": [[{ "node": "Hesabatı göndər", "type": "main", "index": 0 }]] },
    "Qidanı ayrıştır": { "main": [[{ "node": "Qeydi saxla", "type": "main", "index": 0 }]] },
    "Qeydi saxla": { "main": [[{ "node": "Təsdiq göndər", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
